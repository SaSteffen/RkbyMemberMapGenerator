# Copy this file to .env and fill in real values. .env is gitignored — never commit it.
# See specs/001-scraper-persistence/contracts/cli-and-env.md for the full contract.

# Team Rynkeby Intranet login credentials used by scripts/scrape_applicants.py.
RKBY_INTRANET_USERNAME=
RKBY_INTRANET_PASSWORD=

# Absolute path to the local, git-backed data repository root. Must already exist.
RKBY_DATA_DIR=
