# Claude Code local/personal settings (per-machine, not project config)
.claude/settings.local.json

# Python bytecode cache
__pycache__/
*.pyc

# uv-managed virtual environment (uv.lock IS committed for reproducible installs)
.venv/

# Dev tool caches
.pytest_cache/
.ruff_cache/

# frontend/interactive-map/ (003-interactive-photo-map): node_modules and the
# build output are regenerated on every generate_interactive_map.py run
# (pnpm-lock.yaml IS committed for reproducible installs) — never commit built
# JS/CSS, so it can never silently drift from src/.
frontend/*/node_modules/
frontend/*/dist/

# Local team member data and intranet credentials — NEVER commit real member
# data (constitution Principle I: Member Data Privacy First).
data/
.env
*.env
